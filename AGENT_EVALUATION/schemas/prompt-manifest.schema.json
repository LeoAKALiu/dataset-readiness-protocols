{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LeoAKALiu/dataset-readiness-protocols/main/AGENT_EVALUATION/schemas/prompt-manifest.schema.json",
  "title": "Versioned Agent prompt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt_manifest_id", "render_order", "components", "rendered_prompt_path", "rendered_prompt_sha256", "role_output_schema_sha256", "created_at"],
  "properties": {
    "prompt_manifest_id": {"type": "string", "minLength": 1},
    "render_order": {
      "const": ["common_system_contract", "protocol_field_contract", "cluster_dictionary_adapter", "role_adapter"]
    },
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "version", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "rendered_prompt_path": {"type": "string", "minLength": 1},
    "rendered_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role_output_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"properties": {"components": {"contains": {"properties": {"name": {"const": "common_system_contract"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"components": {"contains": {"properties": {"name": {"const": "protocol_field_contract"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"components": {"contains": {"properties": {"name": {"const": "cluster_dictionary_adapter"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"components": {"contains": {"properties": {"name": {"const": "role_adapter"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}}}
  ]
}
